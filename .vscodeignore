# Everything that is not needed at runtime stays out of the VSIX.
.github/**
.vscode/**
.vscode-test/**
src/**
webview/**
tests/**
scripts/**
out/**
**/*.map
**/*.ts
!node_modules/**/*.d.ts
tsconfig.json
eslint.config.mjs
vitest.config.ts
.gitignore
.vscodeignore
*.vsix
CONTRIBUTING.md
docs/architecture.md
# Native command-line binaries of dockerfmt; CodeNeat only uses its WebAssembly build.
node_modules/@reteps/dockerfmt-*/**

# Articles and promotional material are not part of the extension.
marketing/**
