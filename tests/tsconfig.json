{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vscode"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["unit/**/*.ts", "unit/**/*.tsx", "../webview/src/**/*.ts", "../webview/src/**/*.tsx", "integration/**/*.ts", "e2e/**/*.ts", "helpers/**/*.ts", "../src/**/*.ts"]
}
